    <bpmn2:scriptTask id="_BAED451E-A4E7-459C-B7C6-7F8E74DA79AC" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Inicializar datos" scriptFormat="http://www.java.com/java">
