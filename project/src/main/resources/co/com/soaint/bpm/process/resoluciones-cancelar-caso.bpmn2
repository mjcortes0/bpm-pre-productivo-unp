      <bpmn2:outgoing>_362716E9-5E3E-434C-95FC-736478ABD43E</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("nombreTarea","Cancelar casos");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_A2916187-EE70-482F-A196-F3839E059ACA" drools:selectable="true" drools:taskName="MyCustonHandler" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Tracking fin cancelar">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Tracking fin cancelar]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Start at " +
                java.time
                        .LocalTime.now()
                        .format(java.time.format.DateTimeFormatter
                                .ISO_TIME
                        ) + " Creacion de registro de tracking");
//Creacion de objeto para registro tracking
co.com.soaint.bpm.model.domains.TrackDTO track = new co.com.soaint.bpm.model.domains.TrackDTO();

if(kcontext.getVariable("numeroRadicado")!=null){
  track.setObjectId(kcontext.getVariable("numeroRadicado").toString());
}else if(kcontext.getVariable("idEcmDocument")!= null){
    track.setObjectId(kcontext.getVariable("idEcmDocument").toString());
}

track.setObjectType("Documento");

String loginUsuario = kcontext.getVariable("userAsignador") != null ?
 (String) kcontext.getVariable("userAsignador") : null;

if(loginUsuario!=null){
  track.setUser(loginUsuario);
}

track.setTrackStateId(69);// Cancelar caso  - cancelado

String accionCancelar = (String) kcontext.getVariable("accion");

if ("Devuelto".equals(accionCancelar)) {
    track.setTrackStateId(70); //  Cancelar caso  - Devuelto
}

if(kcontext.getVariable("codDependencia")!=null){
  track.setSubsection(Long.parseLong(kcontext.getVariable("codDependencia").toString()));
}
track.setInstanceId(Long.parseLong(kcontext.getVariable("idInstanciaProduccion").toString()));

kcontext.setVariable("trackDTO",track);
]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
