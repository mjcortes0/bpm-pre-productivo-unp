    <bpmn2:callActivity id="_03236108-62A9-4A11-AD99-88E317C1A0CF" drools:selectable="true" drools:independent="true" drools:waitForCompletion="false" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="SubProceso Firma" calledElement="proceso.produccion-firma">
