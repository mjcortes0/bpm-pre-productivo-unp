    <bpmn2:scriptTask id="_999D22B2-0ABF-4AC3-A8E7-336726A6681D" drools:selectable="true" color:background-color="#fafad2" color:border-color="#000000" color:color="#000000" name="Asignar usuario proyector" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Asignar usuario proyector]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_C8C6BEAB-32BB-4150-86EB-A13F4F3544EB</bpmn2:incoming>
      <bpmn2:outgoing>_45DB6C6E-892B-4321-8C6A-FA007D78539F</bpmn2:outgoing>
      <bpmn2:script><![CDATA[ArrayList<String> list=(ArrayList) kcontext.getVariable("listaProyector");
String usuarioDependencia = list.get((int) kcontext.getVariable("indice"));

String[] parts = usuarioDependencia.split(":");
String usuario= parts[0]; 
String dependencia = parts[1];

kcontext.setVariable("usuarioProyector", usuario);
kcontext.setVariable("codDependencia", dependencia );

]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:startEvent id="_C9B8E380-2387-4F4B-BC73-F024B4B0D7C2" drools:selectable="true" color:background-color="#9acd32" color:border-color="#000000" color:color="#000000" name="Iniciar">
