          <bpmn2:to xsi:type="bpmn2:tFormalExpression" id="_mSc-fSCfEfC5LYq3k0yZhA">_4184B37B-92E2-4185-8AA1-A2B766C8A463_OperationInputX</bpmn2:to>
        </bpmn2:assignment>
