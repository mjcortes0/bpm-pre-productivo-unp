    <bpmn2:exclusiveGateway id="_9C7E0A39-3C34-459B-90F9-3923C72E48F8" drools:selectable="true" drools:dg="" color:background-color="#f0e68c" color:border-color="#a67f00" color:color="#000000" name="Aprobado?" gatewayDirection="Diverging">
